{
  "name": "@cxxl/dsh-sqlite",
  "version": "0.3.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH 插件：为 agent 提供持久 SQLite 工具（sqlite_query / sqlite_exec / sqlite_tables / sqlite_export / sqlite_import）、只读表浏览设置页与持久化使用提示词规则——除 Node 22 内置 node:sqlite 外零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tools.js",
    "lib/engine.js",
    "lib/coordination.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish-files.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "sqlite",
    "database",
    "persistence",
    "sync",
    "deepseek-harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyCxxl/dsh-plugins.git",
    "directory": "plugins/dsh-sqlite"
  }
}
